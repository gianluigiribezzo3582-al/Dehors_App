{
  "expo": {
    "name": "Dehors",
    "slug": "dehors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dehors",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "it.dehors.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "it.dehors.app",
      "adaptiveIcon": {
        "backgroundColor": "#2A3B31",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Dehors Cafè-Bistrot",
      "shortName": "Dehors"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La fotocamera serve allo staff per leggere il QR delle tessere fedeltà.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#2A3B31",
          "defaultChannel": "eventi"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
